# Si ignora tutto il contenuto di wp-content...
/*

# ...e si riammette solo cio' che fa parte di questo progetto.
!.gitignore
!CLAUDE.md
!README.md
!docs/
!.claude/
.claude/*
!.claude/settings.json

!themes/
themes/*
!themes/sorriso-dambrosio/

# Il plugin del sito: qui sta il contenuto (tipi, campi, orari, blocchi).
!plugins/
plugins/*
!plugins/sorriso-dambrosio-core/

# Dipendenze di sviluppo (solo PHPStan): non vanno in deploy.
themes/sorriso-dambrosio/vendor/
plugins/sorriso-dambrosio-core/vendor/

# Rumore di sistema
.DS_Store
__pycache__/
