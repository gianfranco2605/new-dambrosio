{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"category": "sorriso-dambrosio",
	"textdomain": "sorriso-dambrosio-core",
	"name": "sd/casi",
	"version": "1.0.0",
	"title": "Casi clinici",
	"description": "I casi prima/dopo. La galleria resta quella del plugin Before and After.",
	"keywords": [
		"studio",
		"dambrosio"
	],
	"supports": {
		"html": false,
		"align": false,
		"anchor": true,
		"interactivity": {
			"clientNavigation": true
		}
	},
	"attributes": {
		"occhiello": {
			"type": "string",
			"default": ""
		},
		"titolo": {
			"type": "string",
			"default": ""
		},
		"fondo": {
			"type": "string",
			"default": ""
		},
		"fonte": {
			"type": "string",
			"default": "area",
			"enum": [
				"area",
				"professionista",
				"tutti"
			]
		},
		"raggruppa": {
			"type": "string",
			"default": "no",
			"enum": [
				"si",
				"no"
			]
		}
	}
}
