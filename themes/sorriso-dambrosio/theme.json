{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1180px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true,
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#1262fa"
				},
				{
					"name": "Main",
					"slug": "main",
					"color": "#39383A"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#636381"
				},
				{
					"name": "Main Accent",
					"slug": "main-accent",
					"color": "#d0ccde"
				},
				{
					"name": "Primary Accent",
					"slug": "primary-accent",
					"color": "#a51212"
				},
				{
					"name": "Tertiary",
					"slug": "tertiary",
					"color": "#bcc9dd"
				},
				{
					"name": "Base",
					"slug": "base",
					"color": "#fcfcfc"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"name": "DM Sans",
					"slug": "primary",
					"fontFamily": "\"DM Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/DMSans-VariableFont_opsz,wght.woff2"
							]
						}
					]
				},
				{
					"name": "Fraunces",
					"slug": "secondary",
					"fontFamily": "Fraunces, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Fraunces-VariableFont_SOFT,WONK,opsz,wght.woff2"
							]
						}
					]
				},
				{
					"name": "Monospace",
					"slug": "monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Extra Small",
					"slug": "x-small",
					"size": ".875rem",
					"fluid": {
						"min": ".8125rem",
						"max": ".875rem"
					}
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "1rem",
					"fluid": {
						"min": ".9375rem",
						"max": "1rem"
					}
				},
				{
					"name": "Base",
					"slug": "base",
					"size": "1.1875rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.1875rem"
					}
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1.375rem",
					"fluid": {
						"min": "1.1875rem",
						"max": "1.375rem"
					}
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "2.125rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.125rem"
					}
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "3.125rem",
					"fluid": {
						"min": "2rem",
						"max": "3.125rem"
					}
				},
				{
					"slug": "title",
					"name": "Titolo di scheda",
					"size": "3.75rem",
					"fluid": {
						"min": "2.5rem",
						"max": "3.75rem"
					}
				},
				{
					"name": "Extra Extra Large",
					"slug": "xx-large",
					"size": "4.5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.5rem"
					}
				},
				{
					"name": "Display",
					"slug": "display",
					"size": "3.75rem",
					"fluid": {
						"min": "2.5rem",
						"max": "3.75rem"
					}
				}
			]
		},
		"custom": {
			"border": {
				"hairline": "#e3e3ea",
				"field": "#d0ccde"
			},
			"surface": {
				"pure": "#ffffff"
			},
			"scrim": {
				"strong": "rgba(57, 56, 58, 0.82)",
				"soft": "rgba(57, 56, 58, 0.45)",
				"none": "rgba(57, 56, 58, 0)"
			},
			"rule": {
				"onDark": "rgba(252, 252, 252, 0.22)"
			},
			"veil": {
				"deep": "rgba(57, 56, 58, 0.94)",
				"mid": "rgba(57, 56, 58, 0.80)",
				"edge": "rgba(57, 56, 58, 0.35)",
				"none": "rgba(57, 56, 58, 0)"
			},
			"shadow": {
				"bar": "rgba(57, 56, 58, 0.28)",
				"header": "rgba(57, 56, 58, 0.08)"
			},
			"state": {
				"errorTint": "rgba(165, 18, 18, 0.08)",
				"okTint": "rgba(18, 98, 250, 0.08)"
			},
			"space": {
				"3xs": "clamp(0.25rem, 0.6vw, 0.375rem)",
				"2xs": "clamp(0.5rem, 1.2vw, 0.75rem)",
				"xs": "clamp(0.75rem, 1.6vw, 1rem)",
				"sm": "clamp(1rem, 2.2vw, 1.5rem)",
				"md": "clamp(1.25rem, 2.8vw, 2rem)",
				"lg": "clamp(1.75rem, 3.6vw, 2.75rem)",
				"xl": "clamp(2.25rem, 4.6vw, 3.75rem)",
				"2xl": "clamp(3rem, 6vw, 5.5rem)",
				"3xl": "clamp(3.5rem, 7.2vw, 7rem)"
			},
			"measure": {
				"prose": "38rem",
				"lede": "32rem",
				"short": "26rem",
				"hero": "clamp(26rem, 36vw, 33rem)",
				"panel": "clamp(26rem, 54vw, 46rem)"
			},
			"frame": {
				"hero": "16 / 9",
				"wide": "3 / 2",
				"plate": "4 / 3",
				"portrait": "4 / 5",
				"panel": "3 / 4"
			},
			"tap": "2.75rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "small",
					"name": "1 · Stretta",
					"size": "clamp(0.5rem, 1.2vw, 0.75rem)"
				},
				{
					"slug": "medium",
					"name": "2 · Normale",
					"size": "clamp(0.875rem, 2vw, 1.25rem)"
				},
				{
					"slug": "large",
					"name": "3 · Comoda",
					"size": "clamp(1.25rem, 2.8vw, 2rem)"
				},
				{
					"slug": "x-large",
					"name": "4 · Ampia",
					"size": "clamp(1.75rem, 3.6vw, 2.75rem)"
				},
				{
					"slug": "xx-large",
					"name": "5 · Fra i blocchi",
					"size": "clamp(2.25rem, 4.6vw, 3.75rem)"
				},
				{
					"slug": "xxx-large",
					"name": "6 · Fra le parti",
					"size": "clamp(3rem, 6vw, 5.5rem)"
				},
				{
					"slug": "xxxx-large",
					"name": "7 · Fra le sezioni",
					"size": "clamp(3.5rem, 7.2vw, 7rem)"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"blockGap": true,
			"padding": true,
			"margin": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--main)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--medium)",
			"padding": {
				"left": "var(--wp--preset--spacing--medium)",
				"right": "var(--wp--preset--spacing--medium)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--secondary)",
					"fontWeight": "400",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.03"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.12"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "500"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "0.85em",
						"bottom": "0.85em",
						"left": "1.6em",
						"right": "1.6em"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "500",
					"textDecoration": "none",
					"letterSpacing": "0.03em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--main)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--main)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--main)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--main-accent)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--secondary)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "mobile-cta",
			"title": "CTA mobile",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-lo-studio",
			"title": "Pagina: Lo Studio",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-contatti",
			"title": "Pagina: Contatti",
			"postTypes": [
				"page"
			]
		}
	]
}
