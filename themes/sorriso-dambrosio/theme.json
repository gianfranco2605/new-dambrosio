{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "740px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true,
			"palette": [
				{ "name": "Primary", "slug": "primary", "color": "#1262fa" },
				{ "name": "Main", "slug": "main", "color": "#39383A" },
				{ "name": "Secondary", "slug": "secondary", "color": "#636381" },
				{ "name": "Main Accent", "slug": "main-accent", "color": "#d0ccde" },
				{ "name": "Primary Accent", "slug": "primary-accent", "color": "#a51212" },
				{ "name": "Tertiary", "slug": "tertiary", "color": "#bcc9dd" },
				{ "name": "Base", "slug": "base", "color": "#fcfcfc" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"name": "DM Sans",
					"slug": "primary",
					"fontFamily": "\"DM Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/DMSans-VariableFont_opsz,wght.woff2" ]
						}
					]
				},
				{
					"name": "Fraunces",
					"slug": "secondary",
					"fontFamily": "Fraunces, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Fraunces-VariableFont_SOFT,WONK,opsz,wght.woff2" ]
						}
					]
				},
				{
					"name": "Monospace",
					"slug": "monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "name": "Extra Small", "slug": "x-small", "size": ".95rem", "fluid": { "min": ".825rem", "max": ".95rem" } },
				{ "name": "Small", "slug": "small", "size": "1.05rem", "fluid": { "min": ".9rem", "max": "1.05rem" } },
				{ "name": "Base", "slug": "base", "size": "1.165rem", "fluid": { "min": "1rem", "max": "1.165rem" } },
				{ "name": "Medium", "slug": "medium", "size": "1.65rem", "fluid": { "min": "1.2rem", "max": "1.65rem" } },
				{ "name": "Large", "slug": "large", "size": "2.35rem", "fluid": { "min": "1.5rem", "max": "2.35rem" } },
				{ "name": "Extra Large", "slug": "x-large", "size": "2.9rem", "fluid": { "min": "1.875rem", "max": "2.9rem" } },
				{ "name": "Extra Extra Large", "slug": "xx-large", "size": "3.75rem", "fluid": { "min": "2.25rem", "max": "3.75rem" } },
				{ "name": "Display", "slug": "display", "size": "5.25rem", "fluid": { "min": "2.75rem", "max": "5.25rem" } }
			]
		},
		"custom": {
			"accent": {
				"rule": "#ff0d00"
			},
			"border": {
				"card": "#e2e2ef",
				"hairline": "#e3e3ea"
			},
			"surface": {
				"pure": "#ffffff"
			},
			"scrim": {
				"strong": "rgba(57, 56, 58, 0.82)",
				"soft": "rgba(57, 56, 58, 0.45)",
				"none": "rgba(57, 56, 58, 0)"
			},
			"shadow": {
				"card": "rgba(57, 56, 58, 0.45)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--main)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--medium)",
			"padding": {
				"left": "var(--wp--preset--spacing--medium)",
				"right": "var(--wp--preset--spacing--medium)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--secondary)",
					"fontWeight": "400",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1.04"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.12"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "500"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "4px" },
				"spacing": {
					"padding": {
						"top": "0.85em",
						"bottom": "0.85em",
						"left": "1.6em",
						"right": "1.6em"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "500",
					"textDecoration": "none",
					"letterSpacing": "0.03em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--main)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--main)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--main)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--main-accent)" }
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--secondary)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "mobile-cta", "title": "CTA mobile", "area": "uncategorized" }
	]
}
