parameters:
	level: 5

	# Il sito gira su PHP 8.3 in locale e in produzione.
	phpVersion: 80300

	paths:
		- functions.php
		- patterns

	excludePaths:
		- vendor

	# I file in patterns/ sono frammenti di template: aprono e chiudono i tag
	# PHP attorno a blocchi di HTML, quindi non dichiarano namespace o classi.
	treatPhpDocTypesAsCertain: false
