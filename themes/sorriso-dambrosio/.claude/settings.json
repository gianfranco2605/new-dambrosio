{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(wp:*)",
      "Bash(curl -s http://sorrisodambrosio.local:*)",
      "Bash(curl -s -o /dev/null -w:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Read(../../plugins/sorriso-dambrosio-core/blocks/**)",
      "Read(../../plugins/sorriso-dambrosio-core/includes/**)",
      "Read(../../docs/**)"
    ],
    "ask": [
      "mcp__playwright",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(wp db import:*)",
      "Bash(wp search-replace:*)",
      "Bash(wp plugin delete:*)",
      "Bash(wp theme delete:*)",
      "Bash(wp post delete:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(wp db drop:*)",
      "Bash(wp db reset:*)",
      "Bash(wp db clean:*)",
      "Bash(wp site empty:*)",
      "Read(./vendor/**)",
      "Read(**/vendor/**)",
      "Read(**/node_modules/**)",
      "Read(./assets/fonts/**)",
      "Read(../ollie/**)",
      "Read(../sorrisodambrosio/**)",
      "Read(../../uploads/**)",
      "Read(../../.playwright-mcp/**)",
      "Read(**/*.sql)",
      "Read(**/*.png)",
      "Read(**/*.jpg)",
      "Read(**/*.webp)"
    ]
  }
}
